# Desarrollo / local. Para producción usa:
#   cp .env.production.example .env.production
#   npm run docker:prod

# Database
POSTGRES_USER=isp
POSTGRES_PASSWORD=isp
POSTGRES_DB=isp_control
POSTGRES_PORT=5432

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=isp
DATABASE_PASSWORD=isp
DATABASE_NAME=isp_control

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# API
PORT=3000
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Web (local npm / docker dev)
VITE_API_URL=http://localhost:3000/api
WEB_PORT=80

# Landing (marketing) — dominio aparte del panel
# Dev: http://localhost:3040  · Prod default: 8080
LANDING_PORT=3040
# URL del panel a la que apuntan los CTAs del landing
PANEL_URL=http://localhost:5173

# VPN concentrator (SaaS shared — logical tunnels per tenant)
# Host/ports that MikroTik clients connect to
VPN_PUBLIC_HOST=vpn.example.com
VPN_PORT_OPENVPN_TCP=1194
VPN_PORT_OPENVPN_UDP=1195
VPN_PORT_WIREGUARD=51820
# Concentrador WireGuard (multi-tenant). Misma public key en todos los scripts MikroTik.
# VPN_WIREGUARD_SERVER_PUBLIC_KEY=
# VPN_WIREGUARD_SERVER_PRIVATE_KEY=
# Public API base (JSON / VPN bootstrap). Prefer Admin → Ajustes → Dominio.
# Example: https://api.tuisp.com/api
PUBLIC_API_URL=http://localhost:3000/api
# Panel web origin (captive portal lives here: /{slug}/suspension). Not under /api.
# Dev with Vite: http://localhost:5173  · Prod: https://panel.tuisp.com
PUBLIC_WEB_URL=http://localhost:5173
# WhatsApp Baileys sidecar (shared secret with API)
WHATSAPP_BAILEYS_URL=http://whatsapp-baileys:3101
WHATSAPP_BAILEYS_SECRET=dev-wa-secret-change-me
# Meta Graph API version used by WhatsApp Cloud API
WHATSAPP_GRAPH_API_VERSION=v23.0
