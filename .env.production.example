###############################################################################
# ISP Control — variables de producción (archivo único)
#
# Uso:
#   cp .env.production.example .env.production
#   nano .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Tres subdominios recomendados (TLS en reverse proxy externo):
#   panel.tudominio.com  → WEB_PORT     (SPA + portal cautivo /{slug}/suspension)
#   api.tudominio.com    → API_PORT     (Nest /api/*)
#   vpn.tudominio.com    → VPN_PORT_*   (concentrador OpenVPN/WireGuard; no HTTP)
#   www / landing        → LANDING_PORT
###############################################################################

# ── Imágenes Docker Hub (públicas) ──────────────────────────────────────────
DOCKERHUB_USER=dubidubidu
IMAGE_TAG=latest

# ── Puertos publicados en el host (Docker) ──────────────────────────────────
WEB_PORT=80
API_PORT=3000
LANDING_PORT=8080

# ── Dominios / URLs públicas ────────────────────────────────────────────────
# Panel (SPA). Portal cautivo: {PUBLIC_WEB_URL}/{slug}/suspension
PUBLIC_WEB_URL=https://panel.tudominio.com
PANEL_URL=https://panel.tudominio.com

# API en subdominio propio (sin slash final). Incluye el prefijo /api de Nest.
PUBLIC_API_URL=https://api.tudominio.com/api
# Front (build-time). Misma base que PUBLIC_API_URL.
VITE_API_URL=https://api.tudominio.com/api

# CORS: orígenes del panel (y landing si llama a la API)
CORS_ORIGINS=https://panel.tudominio.com,https://www.tudominio.com

# ── VPN concentrador (host + puertos públicos) ──────────────────────────────
# Hostname o IP que los MikroTik usan en connect-to / endpoint-address.
# No es HTTP: abre estos puertos UDP/TCP hacia el concentrador (firewall / DNAT).
VPN_PUBLIC_HOST=vpn.tudominio.com
VPN_PORT_OPENVPN_TCP=1194
VPN_PORT_OPENVPN_UDP=1195
VPN_PORT_WIREGUARD=51820
# Keypair del concentrador WireGuard compartido (todos los tenants = peers).
# Generar: node -e "const {generateKeyPairSync}=require('crypto'); const k=generateKeyPairSync('x25519'); const priv=k.privateKey.export({type:'pkcs8',format:'der'}); const pub=k.publicKey.export({type:'spki',format:'der'}); console.log(Buffer.from(priv).subarray(-32).toString('base64')); console.log(Buffer.from(pub).subarray(-32).toString('base64'));"
VPN_WIREGUARD_SERVER_PUBLIC_KEY=CAMBIAR_wg_server_public_base64
VPN_WIREGUARD_SERVER_PRIVATE_KEY=CAMBIAR_wg_server_private_base64
# (en .env.production real: valores generados; la privada solo en el concentrador / API admin)

# ── Base de datos (Postgres) ────────────────────────────────────────────────
POSTGRES_USER=isp
POSTGRES_PASSWORD=CAMBIAR_password_largo_y_seguro
POSTGRES_DB=isp_control

# ── Autenticación / tokens ──────────────────────────────────────────────────
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
WHATSAPP_BAILEYS_SECRET=CAMBIAR_secreto_baileys_largo
WHATSAPP_GRAPH_API_VERSION=v23.0

# ── Notas ───────────────────────────────────────────────────────────────────
# - No subas .env.production al git.
# - Bootstrap MikroTik descarga el .rsc desde:
#     {PUBLIC_API_URL}/public/vpn-setup/{token}
# - El túnel VPN usa VPN_PUBLIC_HOST + VPN_PORT_* (no pasa por nginx HTTP).
# - Seed: docker compose -f docker-compose.prod.yml --env-file .env.production --profile seed run --rm seed
