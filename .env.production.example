###############################################################################
# ISP Control — variables de producción (archivo único)
#
# Uso:
#   cp .env.production.example .env.production
#   nano .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Tres subdominios recomendados (TLS en reverse proxy externo):
#   panel.tudominio.com  → WEB_PORT     (SPA + portal cautivo /{slug}/suspension)
#   api.tudominio.com    → API_PORT     (Nest /api/*)
#   vpn.tudominio.com    → VPN_PORT_*   (concentrador OpenVPN/WireGuard; no HTTP)
#   www / landing        → LANDING_PORT
#
# VPN por tenant / TR069: se configuran en el panel (MikroTik cliente → concentrador).
###############################################################################

# ── Imágenes Docker Hub (públicas) ──────────────────────────────────────────
DOCKERHUB_USER=vive3d
IMAGE_TAG=latest

# ── Puertos publicados en el host (Docker) ──────────────────────────────────
# Solo estos. Postgres/Redis/Mongo/NBI/CWMP/WhatsApp NO se publican (red interna).
WEB_PORT=80
API_PORT=3000
LANDING_PORT=8080
ACS_UI_PORT=3001

# ── Dominios / URLs públicas ────────────────────────────────────────────────
PUBLIC_WEB_URL=https://panel.tudominio.com
PANEL_URL=https://panel.tudominio.com
PUBLIC_API_URL=https://api.tudominio.com/api
VITE_API_URL=https://api.tudominio.com/api
CORS_ORIGINS=https://panel.tudominio.com,https://www.tudominio.com

# ── VPN concentrador (plataforma) ───────────────────────────────────────────
# Hostname/IP público del concentrador. Los peers/túneles salen del panel.
VPN_PUBLIC_HOST=vpn.tudominio.com
VPN_PORT_OPENVPN_TCP=1194
VPN_PORT_OPENVPN_UDP=1195
VPN_PORT_WIREGUARD=51820
VPN_WIREGUARD_SERVER_PUBLIC_KEY=CAMBIAR_wg_server_public_base64
VPN_WIREGUARD_SERVER_PRIVATE_KEY=CAMBIAR_wg_server_private_base64
# Secreto compartido API ↔ vpn-concentrator (header X-VPN-SYNC-SECRET)
VPN_SYNC_SECRET=CAMBIAR_openssl_rand_hex_32

# ── Base de datos (Postgres) ────────────────────────────────────────────────
POSTGRES_USER=isp
POSTGRES_PASSWORD=CAMBIAR_password_largo_y_seguro
POSTGRES_DB=isp_control
# false en operación normal. true solo para bootstrap/mantenimiento controlado.
DATABASE_SYNCHRONIZE=false

# Solo para `npm run docker:seed:prod` (mínimo 12 caracteres).
SEED_ADMIN_EMAIL=admin@isp.local
SEED_ADMIN_PASSWORD=CAMBIAR_password_inicial_largo
SEED_DEMO_DATA=false

# ── Autenticación / tokens ──────────────────────────────────────────────────
JWT_SECRET=CAMBIAR_generar_con_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
WHATSAPP_BAILEYS_SECRET=CAMBIAR_secreto_baileys_largo
WHATSAPP_GRAPH_API_VERSION=v23.0

# Web Push (avisos del sistema para la campanita). Generar:
#   npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:soporte@tudominio.com

# ── TR069 / GenieACS (servicio listo; perfiles ACS en el panel) ─────────────
TR069_NBI_URL=http://vpn-concentrator:7557
TR069_ACS_PROBE_HOST=vpn-concentrator
GENIEACS_MONGODB_URL=mongodb://acs-mongo:27017/genieacs
GENIEACS_CWMP_PORT=14501
GENIEACS_NBI_PORT=7557
GENIEACS_FS_PORT=7567
GENIEACS_UI_JWT_SECRET=CAMBIAR_openssl_rand_hex_32

# ── OLT SSH: fingerprints obligatorios en producción ────────────────────────
# Obtener el SHA256 por un canal confiable y mapear cada host/puerto:
# {"10.0.0.2:22":"SHA256:base64_sin_padding"}
OLT_SSH_HOST_KEYS={}
# Solo emergencia: true desactiva la verificación para OLT sin fingerprint.
OLT_SSH_ALLOW_UNVERIFIED=false

# ── Notas ───────────────────────────────────────────────────────────────────
# - No subas .env.production al git.
# - Bootstrap MikroTik: {PUBLIC_API_URL}/public/vpn-setup/{token}
